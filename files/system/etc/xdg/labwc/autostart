#!/bin/sh

# Import session environment into the user systemd instance and start DMS + helpers.
# Include wlroots in XDG_CURRENT_DESKTOP so the wlroots portal backend is used.
export XDG_CURRENT_DESKTOP="labwc:wlroots"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-labwc}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
systemctl --user import-environment DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE

# Make sure dbus-activated services (like xdg-desktop-portal) see the session env.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE
fi

# Clear any previous failures so path/service units can start cleanly.
systemctl --user reset-failed \
  dms.service \
  dms.path \
  labwc-menu-update.service \
  labwc-menu-update.path \
  labwc-themerc-update.service \
  labwc-themerc-update.path \
  xdg-desktop-portal.service \
  xdg-desktop-portal-wlr.service \
  flameshot-theme-update.service \
  flameshot-theme-update.path \
  flameshot.service >/dev/null 2>&1 || true

# Start/prime DMS and helper generators; path units keep them updated as state changes.
systemctl --user start \
  dms.service \
  dms.path \
  labwc-menu-update.service \
  labwc-menu-update.path \
  labwc-themerc-update.service \
  labwc-themerc-update.path \
  xdg-desktop-portal-wlr.service \
  xdg-desktop-portal.service \
  flameshot-theme-update.service \
  flameshot-theme-update.path \
  flameshot.service \
  graphical-session.target >/dev/null 2>&1 || true
