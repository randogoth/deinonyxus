[Unit]
Description=Generate Labwc menu with DMS integrations
After=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/dms/labwc-menu-update.sh
ConditionEnvironment=XDG_CURRENT_DESKTOP=labwc
ConditionEnvironment=|XDG_CURRENT_DESKTOP=labwc:wlroots

[Install]
WantedBy=default.target
