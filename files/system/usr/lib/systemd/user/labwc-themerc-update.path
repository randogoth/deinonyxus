[Unit]
Description=Watch DMS color changes to refresh Labwc theme
ConditionEnvironment=XDG_CURRENT_DESKTOP=labwc
ConditionEnvironment=|XDG_CURRENT_DESKTOP=labwc:wlroots

[Path]
PathChanged=%h/.cache/DankMaterialShell/dms-colors.json
Unit=labwc-themerc-update.service

[Install]
WantedBy=default.target
