<?xml version="1.0"?>
<labwc_config>
  <theme>
    <name>dms-labwc</name>
    <font name="Inter" size="10" />
  </theme>
  <menu>
    <file>~/.config/labwc/menu.xml</file>
    <icon-theme>Adwaita</icon-theme>
    <icon-size>24</icon-size>
  </menu>
  <keyboard>
    <!-- Alt+Tab: cycle between windows -->
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <!-- Super+Tab: cycle between windows -->
    <keybind key="W-Tab">
      <action name="PreviousWindow" />
    </keybind>
    <!-- Control+W: close window -->
    <keybind key="C-W">
      <action name="Close" />
    </keybind>
    <!-- Control+W: kill window -->
    <keybind key="W-Q">
      <action name="Kill" />
    </keybind>
    <!-- Alt+F4: close window -->
    <keybind key="A-F4">
      <action name="Close" />
    </keybind>
    <!-- Super+Enter: open terminal -->
    <keybind key="W-Return">
      <action name="Execute">
        <command>ghostty</command>
      </action>
    </keybind>
    <keybind key="W-T">
      <action name="Execute">
        <command>ghostty</command>
      </action>
    </keybind>
    <!-- Super+Left/Right: snap to edge -->
    <keybind key="W-Left">
      <action name="SnapToEdge" direction="left" combine="yes" />
    </keybind>
    <keybind key="W-Right">
      <action name="SnapToEdge" direction="right" combine="yes" />
    </keybind>
    <!-- Super+Up/Down: toggle maximize/reset -->
    <keybind key="W-Up">
      <action name="ToggleMaximize" direction="both" />
    </keybind>
    <keybind key="W-Down">
      <action name="Unsnap" />
    </keybind>
    <!-- Super+m: minimize -->
    <keybind key="W-m">
      <action name="Iconify" />
    </keybind>
    <keybind key="W-d">
      <action name="ForEach">
      	<query/>
      	<then>
      		<action name="Iconify" />
      	</then>
      </action>
    </keybind>
    <!-- Super+F: fullscreen -->
    <keybind key="W-F">
      <action name="ToggleFullscreen" />
    </keybind>
    <!-- F11: fullscreen -->
    <keybind key="F11">
      <action name="ToggleFullscreen" />
    </keybind>
    <!-- Alt+directions: tile control -->
    <keybind key="A-Left">
      <action name="SnapToEdge" direction="left" combine="yes" />
    </keybind>
    <keybind key="A-Right">
      <action name="SnapToEdge" direction="right" combine="yes" />
    </keybind>
    <keybind key="A-Up">
      <action name="SnapToEdge" direction="up" combine="yes" />
    </keybind>
    <keybind key="A-Down">
      <action name="SnapToEdge" direction="down" combine="yes" />
    </keybind>
    <!-- Super release: launch DMS launcher button -->
    <keybind key="Super_L" onRelease="true">
      <action name="Execute">
        <command>dms ipc call widget toggle launcherButton</command>
      </action>
    </keybind>
    <!-- Print Screen: launch Flameshot -->
    <keybind key="Print">
      <action name="Execute">
        <command>dms screenshot</command>
      </action>
    </keybind>
    <!-- Super + E: launch Thunar -->
    <keybind key="W-E">
      <action name="Execute">
        <command>thunar</command>
      </action>
    </keybind>
    <keybind key="F9">
      <action name="ShowMenu" menu="root-menu"/>
    </keybind>
    <keybind key="A-S-Tab" />
    <keybind key="W-a" />
    <!-- Brightness controls (hardware keys) -->
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute">
        <command>dms ipc call brightness increment 5 ""</command>
      </action>
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute">
        <command>dms ipc call brightness decrement 5 ""</command>
      </action>
    </keybind>
    <!-- Volume controls (hardware keys) -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute">
        <command>pactl set-sink-volume @DEFAULT_SINK@ +5%</command>
      </action>
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute">
        <command>pactl set-sink-volume @DEFAULT_SINK@ -5%</command>
      </action>
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute">
        <command>pactl set-sink-mute @DEFAULT_SINK@ toggle</command>
      </action>
    </keybind>
    <keybind key="XF86AudioMicMute">
      <action name="Execute">
        <command>pactl set-source-mute @DEFAULT_SOURCE@ toggle</command>
      </action>
    </keybind>
    <keybind key="W-V">
      <action name="Execute">
        <command>dms ipc clipboard open</command>
      </action>
    </keybind>
    <keybind key="W-L">
      <action name="Execute">
        <command>dms ipc call lock lock</command>
      </action>
    </keybind>
  </keyboard>
  <applications>
  </applications>
  <windowRules>
    <!-- Disable decorations for Ghostty (cover common app-ids) -->
    <windowRule identifier="com.mitchellh.ghostty" serverDecoration="no" clientDecoration="no" />
  </windowRules>
</labwc_config>
